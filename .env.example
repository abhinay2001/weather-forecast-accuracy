# Copy this file to .env and adjust if you want non-default credentials.
# None of this is secret — it's all local-only, throwaway dev credentials
# for containers running on your own machine. No API key is needed
# anywhere in this project; Open-Meteo is fully unauthenticated.

# Airflow's own admin login (webserver at http://localhost:8080)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# The warehouse database dbt and the dashboard will connect to
# (also reachable from your host machine at localhost:5433)
WAREHOUSE_DB_USER=weather
WAREHOUSE_DB_PASSWORD=weather
WAREHOUSE_DB_NAME=weather

# Linux only: run `id -u` and put the result here so files Airflow
# writes in mounted volumes are owned by you, not root. Not needed
# on macOS/Windows Docker Desktop.
AIRFLOW_UID=50000
